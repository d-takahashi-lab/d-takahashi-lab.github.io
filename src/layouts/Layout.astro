---
import '../styles/global.css';
import { navigation } from '../data/navigation';
import { pageUrl, choose, type Language } from '../lib/i18n';
interface Props {title?: string; current?: string; description?: string; noindex?: boolean; lang?: Language; alternateSlug?:string; languageSlugs?:{ja:string;en:string}; hasEnglishArticle?:boolean;}
const {title = '', current = '', description, noindex = false, lang = 'ja'} = Astro.props;
const en = lang === 'en';
const t = (ja:string, english:string) => choose(lang,ja,english);
const pageLabel = navigation.find(p=>p.slug===current)?.label;
const labName = t('生命適応科学研究室','Laboratory of Stress and Adaptation Biology');
const pageTitle = title ? `${en && !Astro.props.alternateSlug ? pageLabel || title : title} | ${labName}` : `${labName} | ${t('埼玉大学','Saitama University')}`;
const pageDescription = description || t('埼玉大学 生命適応科学研究室。植物の低温・凍結・乾燥への適応機構を、細胞壁と多糖に着目して研究しています。','We study plant adaptation to cold, freezing and desiccation, focusing on the structure and function of cell walls and polysaccharides at Saitama University.');
const publishedSite = Astro.site && Astro.site.hostname !== 'example.github.io' ? Astro.site : undefined;
const canonical = publishedSite ? new URL(Astro.url.pathname, publishedSite).href : undefined;
const base = import.meta.env.BASE_URL;
const alternateSlug = Astro.props.alternateSlug ?? (navigation.some(p=>p.slug===current) ? current : '');
const jaSlug=Astro.props.languageSlugs?.ja??alternateSlug,enSlug=Astro.props.languageSlugs?.en??alternateSlug;
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>{pageTitle}</title><meta name="description" content={pageDescription} />
 {canonical && <link rel="canonical" href={canonical} />}
 {publishedSite && <><link rel="alternate" hreflang="ja" href={new URL(pageUrl(jaSlug,'ja'),publishedSite).href}/>{Astro.props.hasEnglishArticle!==false&&<link rel="alternate" hreflang="en" href={new URL(pageUrl(enSlug,'en'),publishedSite).href}/>}<link rel="alternate" hreflang="x-default" href={new URL(pageUrl(jaSlug,'ja'),publishedSite).href}/></>}
 {noindex && <meta name="robots" content="noindex" />}
 <meta name="theme-color" content="#ffffff" /><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
 <meta property="og:title" content={pageTitle} /><meta property="og:description" content={pageDescription} />
 {canonical && <meta property="og:url" content={canonical} />}
 <meta property="og:locale" content={en?'en_US':'ja_JP'} /><meta property="og:type" content="website" />
</head>
<body>
<a class="skip" href="#main">{t('本文へ移動','Skip to content')}</a>
<header class="header">
 <a class="lab-identity" href={pageUrl('',lang)} aria-label={t('生命適応科学研究室 ホーム','Laboratory of Stress and Adaptation Biology — Home')}><img src={`${base}images/lab-mark.svg`} alt="" width="40" height="40" /><span class="identity-name">{labName}</span>{en&&<span class="identity-name-compact" aria-hidden="true">Stress &amp; Adaptation Biology</span>}</a>
 <nav id="navigation" aria-label={t('メインナビゲーション','Main navigation')}>{navigation.map(item => <a href={pageUrl(item.slug,lang)} aria-current={current === item.slug ? 'page' : undefined} title={en?item.label:item.title}>{item.label}</a>)}</nav>
 <div class="header-actions"><div class="language-switch" aria-label={t('言語','Language')}><a href={pageUrl(jaSlug,'ja')} lang="ja" hreflang="ja" aria-label="日本語" aria-current={!en?'page':undefined} data-language-switch>JP</a><span aria-hidden="true">/</span><a href={pageUrl(enSlug,'en')} lang="en" hreflang="en" aria-label="English" aria-current={en?'page':undefined} data-language-switch>EN</a></div><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span>＋</span></button></div>
</header>
<main id="main"><slot /></main>
<footer><div class="footer-navigation"><div class="footer-links"><a href={en?'https://en.saitama-u.ac.jp/':'https://www.saitama-u.ac.jp/'}>{t('埼玉大学','Saitama University')} ↗</a><a href="https://park.saitama-u.ac.jp/~molbiol/">{t('理学部分子生物学科','Department of Molecular Biology')} ↗</a><a href="https://www.saitama-u.ac.jp/rikogaku/">{t('大学院理工学研究科','Graduate School of Science and Engineering')} ↗</a></div><a class="back-to-top" href="#main">{t('ページ上部へ','Back to top')} ↑</a></div></footer>
<script>
 const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
 const nav = document.querySelector<HTMLElement>('#navigation');
 const close = () => { toggle?.setAttribute('aria-expanded','false'); nav?.classList.remove('open'); };
 toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open);});
 nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
 document.addEventListener('keydown',e=>{if(e.key==='Escape' && toggle?.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});
 document.querySelectorAll<HTMLAnchorElement>('[data-language-switch]').forEach(a=>a.addEventListener('click',()=>{const u=new URL(a.href);u.search=location.search;u.hash=location.hash;a.href=u.href;}));
</script>
</body>
</html>
