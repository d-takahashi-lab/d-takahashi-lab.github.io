---
import PublicationTitle from './PublicationTitle.astro';
import {publicationTypes,type Publication} from '../data/publications';
import {type Language} from '../lib/i18n';
interface Props{paper:Publication;lang?:Language;}
const {paper:p,lang='ja'}=Astro.props;
const en=lang==='en';
const types={article:'Research article',review:'Review',chapter:'Book chapter'};
const label=en?types[p.type as keyof typeof types]:publicationTypes[p.type as keyof typeof publicationTypes];
const cover=p.cover;
const authors=p.authors.split(', ');
const roleNotes:Record<string,string>={'*共同責任著者・同等貢献':'*Co-corresponding authors; equal contribution','*共同責任著者':'*Co-corresponding authors','*共同第一著者':'*Co-first authors'};
const sources:Record<string,string>={'埼玉大学プレスリリース':'Saitama University release (Japanese)','JST Science Japan':'JST Science Japan','JST 客観日本':'JST Science Portal China','科学新聞':'Science News (Japanese)','サイエンスポータル':'Science Portal (Japanese)','特集号カバーページ':'Special issue','カバーイメージ':'Issue cover','基礎生物学研究所プレスリリース':'NIBB release (Japanese)'};
const note=en?p.note.replace('オンライン公開：','First online: ').replace('年',''):p.note;
---
<article class:list={['pub-entry', {'pub-entry-with-cover': cover}]} id={p.id} data-publication data-year={p.year} data-type={p.type} data-search={`${p.title} ${p.authors} ${p.reference} ${p.pages} ${p.doi}`.toLowerCase()}>
 <div>
 <div class="pub-meta"><span>{label}</span>{note&&<span>{note}</span>}</div>
 <h3><a href={p.url}><PublicationTitle title={p.title} /><span class="external-arrow" aria-hidden="true"> ↗</span></a></h3>
 <p class="pub-authors">{authors.map((author,index)=><>{index>0&&', '}{/^Takahashi D\*?$/.test(author)?<strong>{author}</strong>:author}</>)}</p>
 <p class="pub-reference">{p.reference}</p>
 {p.roleNote&&<p class="pub-note">{en?roleNotes[p.roleNote]||p.roleNote:p.roleNote}</p>}
 <div class="pub-actions">
  <a href={p.url} class="doi-link">{p.doi?`DOI: ${p.doi}`:en?'Publisher page':'出版社のページ'} <span aria-hidden="true">↗</span></a>
  {p.related.map(l=><a href={l.url}>{en?sources[l.label]||l.label:l.label} <span aria-hidden="true">↗</span></a>)}
 </div>
 </div>
 {cover&&<figure class="publication-cover">
  <img src={`${import.meta.env.BASE_URL}images/${cover.file}`} width={cover.width} height={cover.height} alt={`${p.journal} — ${en?cover.labelEn:cover.label}`} loading="lazy" decoding="async" />
  <figcaption>{en?cover.labelEn:cover.label}<br />{en?'Photo':'写真'} · {cover.credit}</figcaption>
 </figure>}
</article>
