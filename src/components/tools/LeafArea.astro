   {!en&&<p id="la-cite-ja" data-citation={citationJa}>{citationJa}（参照 <span data-today>{tool.updated}</span>）</p>}
  </div>
  <div class="tool-buttons">
   <button type="button" class="tool-button" data-copy="la-cite-en">{t('英語の引用文をコピー','Copy citation')}</button>
   {!en&&<button type="button" class="tool-button" data-copy="la-cite-ja">日本語の引用文をコピー</button>}
  </div>
  <p class="body-note">{t('コピーした結果と保存したCSVにも、計算に使ったバージョンが記録されます。','Copied results and saved CSV files also record the version used.')}</p>
 </section>

