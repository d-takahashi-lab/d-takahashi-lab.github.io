---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../PageHeading.astro';
import EmailContact from '../EmailContact.astro';
import {choose,type Language} from '../../lib/i18n';
interface Props{lang?:Language;}
const {lang='ja'}=Astro.props;
const en=lang==='en',t=(ja:string,english:string)=>choose(lang,ja,english);
const base=import.meta.env.BASE_URL;
const routes=[
 {station:t('北浦和駅','Kita-Urawa Station'),line:t('JR京浜東北線','JR Keihin-Tohoku Line'),from:t('西口','West exit'),bus:t('「埼玉大学」ゆき → 終点「埼玉大学」','Bus bound for Saitama Daigaku → get off at the terminus'),time:t('約15分','About 15 min')},
 {station:t('南与野駅','Minami-Yono Station'),line:t('JR埼京線','JR Saikyo Line'),from:t('西口・北入口','West exit or Kita-iriguchi stop'),bus:t('「埼玉大学」を経由するバス →「埼玉大学」','Bus via Saitama Daigaku → get off at Saitama Daigaku'),time:t('約10分','About 10 min')},
 {station:t('志木駅','Shiki Station'),line:t('東武東上線','Tobu Tojo Line'),from:t('東口','East exit'),bus:t('「南与野駅西口」ゆき →「埼玉大学」','Bus bound for Minami-Yono Station West Exit → get off at Saitama Daigaku'),time:t('約25分','About 25 min')},
];
---
<Layout lang={lang} title="アクセス・お問い合わせ" current="contact" description={t('埼玉大学生命適応科学研究室の所在地、連絡先と交通案内。さいたま市桜区下大久保255、理学部3号館。','Contact and directions for the Laboratory of Stress and Adaptation Biology, Faculty of Science Building No. 3, Saitama University, Japan.')}>
 <PageHeading lang={lang} title="アクセス・お問い合わせ" en="CONTACT & ACCESS" sections={[
  {label:t('お問い合わせ','Enquiries'),href:'#inquiry'},{label:t('所在地','Location'),href:'#location'},
  {label:t('交通案内','Directions'),href:'#directions'},
 ]}/>
 <section class="section inquiry-section" id="inquiry"><h2>{t('お問い合わせ','Enquiries')}</h2><div class="inquiry-grid"><div><p class="body-text">{t('研究内容、共同研究、研究室見学については、高橋大輔までメールでご連絡ください。','For research enquiries, collaborations or laboratory visits, please contact Daisuke Takahashi by email.')}</p><EmailContact lang={lang}/><p class="body-note">{t('研究室訪問をご希望の方は、事前に日程をご相談ください。','Please arrange a date in advance if you would like to visit the laboratory.')}</p></div><dl class="contact-facts"><div><dt>{t('担当','Contact')}</dt><dd>{t('高橋 大輔 / 准教授','Daisuke Takahashi / Associate Professor')}</dd></div><div><dt>{t('電話','Phone')}</dt><dd><a href="tel:+81488583399">{en?'+81-48-858-3399':'048-858-3399'}</a><small>{t('海外から：+81-48-858-3399','Within Japan: 048-858-3399')}</small></dd></div></dl></div></section>
 <section class="section location-section" id="location"><h2>{t('所在地','Location')}</h2><div class="location-grid"><div><address>{en?<>255 Shimookubo, Sakura-ku<br/>Saitama City, Saitama Prefecture 338-8570, JAPAN<strong>Faculty of Science Building No. 3<br/>Saitama University</strong></>:<>〒338-8570<br/>埼玉県さいたま市桜区下大久保255<br/><strong>埼玉大学 理学部3号館</strong></>}</address><div class="profile-links"><a href="https://www.google.com/maps/search/?api=1&query=Saitama+University+Faculty+of+Science+Building+3">Google Maps ↗</a><a href="https://www.saitama-u.ac.jp/access/map.pdf">{t('大学公式キャンパスマップ（PDF）','Official campus map (PDF)')} ↗</a></div></div><figure class="campus-map"><a href={`${base}images/campus-science-map${en?'-en':''}.svg`} aria-label={t('理学部3号館の位置を示す地図を拡大','Enlarge the map showing Faculty of Science Building No. 3')}><img src={`${base}images/campus-science-map${en?'-en':''}.svg`} alt={t('大学正門付近の建物配置。理学部3号館は11番で、理学部講義実験棟12番の隣、理学部1号館14番・2号館13番の手前にあります。','Campus layout near the main gate. Faculty of Science Building No. 3 is highlighted as number 11, beside building 12 and in front of buildings 13 and 14.')} width="565" height="630" loading="lazy"/></a><figcaption>{t('理学部3号館は11番です。','Faculty of Science Building 3 is marked 11.')}</figcaption></figure></div></section>
 <section class="section directions-section" id="directions"><h2>{t('交通案内','Directions')}</h2><p class="body-note">{t('各駅からバスで「埼玉大学」へお越しください。','Take a bus from one of the stations below to Saitama Daigaku (Saitama University).')}</p><div class="route-list">{routes.map(r=><article><div><small>{r.line}</small><h3>{r.station}</h3><p>{r.from}</p></div><div class="route-path"><span>{t('バス','Bus')}</span><p>{r.bus}</p></div><div class="route-time"><strong>{r.time}</strong><span>{t('バスの目安','Approximate bus journey')}</span></div></article>)}</div><p class="body-note">{t('所要時間は交通状況により変わります。最新の経路・乗り場は大学公式案内をご確認ください。','Journey times depend on traffic. Please check the university’s official guide for current routes and boarding points.')}</p><a class="text-link" href="https://www.saitama-u.ac.jp/access/accessmap/">{t('埼玉大学の交通案内','University access guide (Japanese)')} ↗</a></section>
</Layout>
