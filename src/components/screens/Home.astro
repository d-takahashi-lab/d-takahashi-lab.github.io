---
import Layout from '../../layouts/Layout.astro';
import PhotoSlideshow from '../PhotoSlideshow.astro';
import {news as jaNews} from '../../data/content';
import {news as enNews} from '../../data/content.en';
import {pageUrl,type Language} from '../../lib/i18n';
interface Props{lang?:Language;}
const {lang='ja'}=Astro.props;
const en=lang==='en',news=en?enNews:jaNews;
---
<Layout lang={lang}>
 <section class="editorial-hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">{en?'Laboratory of Stress and Adaptation Biology, Graduate School of Science and Engineering, Saitama University':'埼玉大学大学院理工学研究科 生命適応科学研究室'}</h1>
  <PhotoSlideshow lang={lang}/>
 </section>
 <section class="home-news home-intro" aria-labelledby="home-about"><div class="news-heading"><h2 id="home-about" lang="en">About</h2></div><div><p>{en?'How do plants survive freezing and drying? We study how they adapt to cold, freezing and desiccation, focusing on carbohydrates and proteins.':<><span class="phrase">植物は、</span><span class="phrase">なぜ凍っても</span><span class="phrase">乾いても</span><span class="phrase">生き延びられるのか。</span><br/><span class="phrase">糖とタンパク質に</span><span class="phrase">注目して、</span><span class="phrase">低温・凍結・乾燥に</span><span class="phrase">適応する</span><span class="phrase">しくみを</span><span class="phrase">調べています。</span></>}</p><a class="text-link" href={pageUrl('research',lang)}>{en?'Our research':'研究紹介へ'} →</a></div></section>
 <section id="news" class="home-news"><div class="news-heading"><h2 lang="en">News</h2></div><div>{news.slice(0,4).map(n=><article class="home-news-row"><time datetime={n.date.replaceAll('.','-')}>{n.date}</time><p><a href={pageUrl(n.articleSlug,lang)}>{n.heading}</a></p></article>)}<a class="text-link" href={pageUrl('news',lang)}>{en?'All news':'すべてのお知らせ'} →</a></div></section>
</Layout>
