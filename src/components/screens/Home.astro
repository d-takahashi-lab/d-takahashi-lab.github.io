---
import Layout from '../../layouts/Layout.astro';
import PhotoSlideshow from '../PhotoSlideshow.astro';
import {news as jaNews} from '../../data/content';
import {news as enNews} from '../../data/content.en';
import {pageUrl,type Language} from '../../lib/i18n';
interface Props{lang?:Language;}
const {lang='ja'}=Astro.props;
const en=lang==='en',news=en?enNews:jaNews;
---
<Layout lang={lang}>
 <section class="editorial-hero" aria-labelledby="hero-title">
  <div class="editorial-title"><p class="home-affiliation">{en?'Graduate School of Science and Engineering, Saitama University':<>埼玉大学<span>大学院理工学研究科</span></>}</p><h1 id="hero-title">{en?'Laboratory of Stress and Adaptation Biology':'生命適応科学研究室'}</h1></div>
  <PhotoSlideshow lang={lang}/>
 </section>
 <section id="news" class="home-news"><div class="news-heading"><h2>News</h2></div><div>{news.slice(0,4).map(n=><article class="home-news-row"><time datetime={n.date.replaceAll('.','-')}>{n.date}</time><p><a href={pageUrl(n.articleSlug,lang)}>{n.heading}</a></p></article>)}<a class="text-link" href={pageUrl('news',lang)}>{en?'All news':'すべてのお知らせ'} →</a></div></section>
</Layout>
