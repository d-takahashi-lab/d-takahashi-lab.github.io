---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../PageHeading.astro';
import * as jaData from '../../data/members';
import * as enData from '../../data/members.en';
import {choose,type Language} from '../../lib/i18n';
interface Props{lang?:Language;}
const {lang='ja'}=Astro.props;
const en=lang==='en';
const {principal,students,alumni}=en?enData:jaData;
const t=(ja:string,english:string)=>choose(lang,ja,english);
const base=import.meta.env.BASE_URL;
const alumniYears=[...new Set(alumni.map(p=>p.year))];
---
<Layout lang={lang} title="メンバー" current="members" description={t('生命適応科学研究室の教員・大学院生・学部生と、各メンバーの研究テーマ、卒業・修了生を紹介します。','Meet our faculty, graduate and undergraduate students, their research interests, and laboratory alumni.')}>
 <PageHeading lang={lang} title="メンバー" en="MEMBERS" sections={[
  {label:t('教員','Faculty'),href:'#faculty'},{label:t('大学院生','Graduate students'),href:'#graduates'},
  {label:t('学部生','Undergraduates'),href:'#undergraduates'},{label:t('卒業・修了生','Alumni'),href:'#alumni'},
 ]}/>
 <section class="faculty-section section" id="faculty" aria-labelledby="faculty-heading"><h2 id="faculty-heading">{t('教員','Faculty')}</h2><div class="faculty-profile"><div class="faculty-identity"><figure><img src={`${base}images/takahashi-profile-coast-full.webp`} alt={principal.name} width="1000" height="1000"/></figure><div><h3>{principal.name}{principal.english&&<small>{principal.english}</small>}</h3><p class="position">{principal.position}</p><p class="affiliation">{principal.affiliation.split('/').map(part=><span>{part.trim()}</span>)}</p></div></div><div class="faculty-details"><small>{t('研究分野','Research interests')}</small><p>{principal.interests.join(en?', ':'、')}</p><div class="profile-links">{principal.links.map(l=><a href={l.url}>{l.label} ↗</a>)}</div></div></div></section>
 {['大学院生','学部生'].map((group,i)=><section class="student-section section" id={i===0?'graduates':'undergraduates'} aria-labelledby={`group-${i}`}><h2 id={`group-${i}`}>{i===0?t('大学院生','Graduate students'):t('学部生','Undergraduates')}</h2><div class="student-list">{students.filter(s=>s.group===group).map(s=><article class="student"><div class="student-name">{s.photo&&<img src={`${base}images/${s.photo}`} alt={s.name} width="900" height="900" loading="lazy"/>}<div><h3>{s.name}</h3><p>{s.role}{s.note&&<span> / {s.note}</span>}</p></div></div><div class="student-topic">{s.topic&&<><small>{t('研究テーマ','Research topic')}</small><p>{s.topic}</p></>}{(s.researchmap||s.url||s.orcid)&&<div class="profile-links">{s.researchmap&&<a href={s.researchmap}>Researchmap ↗</a>}{s.url&&<a href={s.url}>Google Scholar ↗</a>}{s.orcid&&<a href={s.orcid}>ORCID ↗</a>}</div>}</div></article>)}</div></section>)}
 <section class="section alumni-section" id="alumni" aria-labelledby="alumni-heading"><h2 id="alumni-heading">{t('卒業・修了生','Alumni')}</h2><p class="body-note">{t('2025年以前は、植物糖鎖生物学研究室の在籍者を含みます。','Entries through 2025 also include alumni of the Plant Glycobiology Laboratory.')}</p><div class="alumni-list">{alumniYears.map(y=><div class="alumni-year"><h3>{y}</h3><ul>{alumni.filter(a=>a.year===y).map(a=><li><span>{a.name}</span><small>{a.degree}</small></li>)}</ul></div>)}</div></section>
</Layout>
