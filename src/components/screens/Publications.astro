---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../PageHeading.astro';
import PublicationEntry from '../PublicationEntry.astro';
import {publications,publicationTypes as jaTypes,years} from '../../data/publications';
import {choose,type Language} from '../../lib/i18n';
interface Props{lang?:Language;}
const {lang='ja'}=Astro.props;
const en=lang==='en';
const t=(ja:string,english:string)=>choose(lang,ja,english);
const publicationTypes=en?{article:'Research articles',review:'Reviews',chapter:'Book chapters'}:jaTypes;
---
<Layout lang={lang} title="研究業績" current="publications" description={t('生命適応科学研究室の研究業績。原著論文・総説・書籍章を年別に掲載しています。','Research articles, reviews and book chapters from the laboratory, with direct DOI links, organized by year.')}>
 <PageHeading lang={lang} title="研究業績" en="PUBLICATIONS" sections={[
  {label:t('すべて','All'),href:'./'},
  ...Object.entries(publicationTypes).map(([key,label])=>({label,href:`?type=${key}`})),
 ]}/>
 <section class="publication-archive section" aria-label={t('論文一覧','Publications')}>
  <div class="archive-layout"><nav id="publication-years" class="year-index" aria-label={t('掲載年から移動','Browse by year')}>{years.map(y=><a href={`#year-${y}`} data-year-link={y}>{y}</a>)}</nav><div class="year-results" id="publication-list">{years.map(y=><section class="pub-year" id={`year-${y}`} data-year-group><h2>{y}</h2>{publications.filter(p=>p.year===y).map(p=><PublicationEntry paper={p} lang={lang}/>)}</section>)}</div></div>
  <p class="archive-footnote">{t('掲載年は巻号の年を使用し、オンライン公開年が異なる文献には公開年を併記しています。著者の貢献に関する注記は各文献に記載しています。','Publications are listed by volume year. An earlier online publication year is noted where applicable. Author-contribution notes are given with each record.')}</p>
 </section>
</Layout>
<script>
const links=[...document.querySelectorAll<HTMLAnchorElement>('.page-sections a')];
const entries=[...document.querySelectorAll<HTMLElement>('[data-publication]')];
const groups=[...document.querySelectorAll<HTMLElement>('[data-year-group]')];
const linkType=(a:HTMLAnchorElement)=>new URL(a.href).searchParams.get('type')||'';
const types=links.map(linkType);
const currentType=()=>{const type=new URLSearchParams(location.search).get('type')||'';return types.includes(type)?type:'';};
function show(type:string){
 entries.forEach(el=>{el.hidden=!!type&&el.dataset.type!==type;});
 groups.forEach(g=>{const visible=[...g.querySelectorAll<HTMLElement>('[data-publication]')].some(el=>!el.hidden);g.hidden=!visible;const link=document.querySelector<HTMLElement>(`[data-year-link="${g.id.replace('year-','')}"]`);if(link)link.hidden=!visible;});
 links.forEach(a=>{if(linkType(a)===type)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current');});
}
links.forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const type=linkType(a),u=new URL(location.href);u.search='';if(type)u.searchParams.set('type',type);history.replaceState(null,'',u);show(type);}));
window.addEventListener('popstate',()=>show(currentType()));
show(currentType());
</script>
