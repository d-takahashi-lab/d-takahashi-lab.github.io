---
import ScientificText from '../ScientificText.astro';
import PublicationTitle from '../PublicationTitle.astro';
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../PageHeading.astro';
import {themes as jaThemes} from '../../data/research';
import {themes as enThemes} from '../../data/research.en';
import {findPaper} from '../../data/publications';
import {pageUrl,choose,type Language} from '../../lib/i18n';
interface Props{lang?:Language;}
const {lang='ja'}=Astro.props;
const en=lang==='en',themes=en?enThemes:jaThemes;
const t=(ja:string,english:string)=>choose(lang,ja,english);
const base=import.meta.env.BASE_URL;
---
<Layout lang={lang} title="研究紹介" current="research" description={t('低温馴化と脱馴化、細胞壁・多糖による凍結耐性、復活植物の乾燥耐性と糖、タンパク質言語モデルによる天然変性タンパク質の比較を、実験図や動画、関連論文とともに紹介します。','Our research on cold acclimation, cell wall polysaccharides and freezing tolerance, desiccation tolerance in resurrection plants, and comparisons of intrinsically disordered proteins using a protein language model, with diagrams and related publications.')}>
 <PageHeading lang={lang} title="研究紹介" en="RESEARCH" sections={themes.map((theme,i)=>({label:`0${i+1} ${theme.menu}`,href:`#${theme.id}`}))}/>
 <div class="research-content">{themes.map((theme,i)=><section class="research-theme" id={theme.id} aria-labelledby={`${theme.id}-title`}><header class="theme-header"><span class="section-kicker" aria-hidden="true">0{i+1}</span><h2 id={`${theme.id}-title`}>{theme.title}</h2><p><ScientificText text={theme.lead}/></p></header><div class="theme-layout"><div class="theme-text">{theme.sections.map(section=><section class="research-subsection"><h3>{section.heading}</h3>{section.paragraphs.map(p=><p><ScientificText text={p}/></p>)}</section>)}</div><figure class={`science-figure ${theme.id==='cold-acclimation'?'tall-figure':''}`}>
 {'video' in theme&&theme.video?<video controls playsinline muted={theme.autoplay} autoplay={theme.autoplay} loop={theme.autoplay} preload={theme.autoplay?'auto':'none'} poster={`${base}images/${theme.poster}`} aria-label={theme.alt}><source src={`${base}videos/${theme.video}`} type="video/mp4"/><a href={`${base}videos/${theme.video}`}>{t('動画を開く','Open video')}</a></video>:<a href={`${base}images/${theme.figure}`} aria-label={en?`Enlarge diagram: ${theme.title}`:`${theme.title}の図を拡大`}><img src={`${base}images/${theme.figure}`} alt={theme.alt} loading="lazy"/></a>}
 <figcaption><ScientificText text={theme.caption}/></figcaption></figure></div>
 {theme.references.length>0&&<aside class="theme-references" aria-label={t('関連論文','Related publications')}><h3>{t('関連論文','Related publications')}</h3>{theme.references.map(doi=>{const p=findPaper(doi);return <a href={`${pageUrl('publications',lang)}#${p.id}`}><span>{p.year} / {p.journal}</span><p><PublicationTitle title={p.title} italics={p.titleItalics} /> →</p></a>;})}</aside>}</section>)}</div>
</Layout>
