---
interface Props { text: string; }
const { text } = Astro.props;
const names = /\b(Selaginella tamariscina|Selaginella moellendorffii|S\. tamariscina|S\. moellendorffii|Arabidopsis thaliana|Chitiniphilus shinanonensis|Solanum lycopersicum|Beta vulgaris|Pisum sativum)\b/g;
const parts = text.split(names);
---
{parts.map((part, index) => index % 2 ? <i>{part}</i> : part)}
