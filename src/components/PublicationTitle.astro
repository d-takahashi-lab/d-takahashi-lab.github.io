---
interface Props {
 title: string;
}
const { title } = Astro.props;

// Latin taxon names and gene names occurring in the publication titles.
// XTH19 denotes the enzyme in its title and stays in roman type.
const scientificName = /\b(Arabidopsis thaliana|Arabidopsis|Chitiniphilus shinanonensis|Solanum lycopersicum|Beta vulgaris|Pisum sativum|Citrus|Xanthomonas|BRITTLE CULM 4|DRP1E)\b/g;
const parts = title.split(scientificName);
const stereochemicalPrefix = /\b([DL])(?=-[a-z])/g;
---
{parts.map((part, index) => index % 2 ? <i>{part}</i> : part.split(stereochemicalPrefix).map((text, index) => index % 2 ? <span class="stereochemical-prefix">{text}</span> : text))}

<style>
 .stereochemical-prefix { font-size: calc(1em - 2pt); }
</style>
