---
interface Props {
 title: string;
 italics?: string[];
}
const { title, italics = [] } = Astro.props;
const escapeRegExp = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const pattern = italics.length ? new RegExp('(' + italics.map(escapeRegExp).join('|') + ')', 'g') : null;
const parts = pattern ? title.split(pattern) : [title];
const stereochemicalPrefix = /\b([DL])(?=-[a-z])/g;
---
{parts.map((part, index) => pattern && index % 2 ? <i>{part}</i> : part.split(stereochemicalPrefix).map((text, index) => index % 2 ? <span class="stereochemical-prefix">{text}</span> : text))}

<style>
 .stereochemical-prefix { font-size: calc(1em - 2pt); }
</style>
