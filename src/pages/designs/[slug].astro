---
import { designs } from '../../data/designs';
import { news } from '../../data/content';
export function getStaticPaths(){return designs.map(d=>({params:{slug:d.slug},props:{design:d}}));}
const {design:d}=Astro.props;
const base=import.meta.env.BASE_URL;
const flower=`${base}images/top-flowers.webp`, plants=`${base}images/research-plants.webp`;
const nav=[['research','研究紹介'],['members','メンバー'],['publications','研究業績'],['contact','アクセス']];
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{d.name} | デザイン比較</title><meta name="robots" content="noindex"/>
<script is:inline>const q=new URLSearchParams(location.search);document.documentElement.dataset.tone=q.get('tone')||'';document.documentElement.dataset.preview=q.has('preview')?'true':'false';</script>
</head><body class={`${d.kind} default-${d.tone}`}>
<aside class="compare"><a href={`${base}designs/`}>← 一覧</a><span>{d.name}</span><div class="tone-buttons"><button data-tone="dark" type="button">黒背景</button><button data-tone="light" type="button">白背景</button>{d.kind==='editorial'&&<button data-tone="paper" type="button">生成り</button>}</div></aside>
<div class="site">
<header class="site-header"><a class="identity" href={base}>生命適応科学研究室<small>Laboratory of Stress and Adaptation Biology</small></a><nav aria-label="サイトメニュー">{nav.map(([slug,label])=><a href={`${base}${slug}/`}>{label}</a>)}</nav></header>
{d.kind==='gallery'&&<section class="gallery-hero"><img src={flower} alt="斜面に咲く花"/><div class="gallery-title"><p>SAITAMA UNIVERSITY</p><h1>生命適応科学研究室</h1><p>埼玉大学大学院理工学研究科</p></div><a class="gallery-link" href={`${base}research/`}>研究紹介 ↗</a></section>}
{d.kind==='standard'&&<><div class="standard-banner"><img src={flower} alt="斜面に咲く花"/><span>SAITAMA UNIVERSITY</span></div><section class="standard-intro"><h1>植物の環境ストレス応答</h1><p>植物の低温・凍結・乾燥への適応機構を、<br/>細胞壁と多糖に着目して研究しています。</p><a href={`${base}research/`}>研究紹介 →</a></section></>}
{d.kind==='editorial'&&<section class="editorial-hero"><div class="editorial-title"><p>埼玉大学大学院理工学研究科</p><h1>生命適応科学<br/>研究室</h1><p class="english">Laboratory of<br/>Stress and Adaptation Biology</p></div><figure><img src={flower} alt="斜面に咲く花"/><figcaption>植物の環境ストレス応答</figcaption></figure></section>}
{d.kind==='split'&&<section class="split-hero"><div><p class="micro">SAITAMA UNIVERSITY</p><h1>生命適応科学<br/>研究室</h1><p class="english">Laboratory of Stress<br/>and Adaptation Biology</p><p class="description">植物の低温・凍結・乾燥への適応機構を、細胞壁と多糖に着目して研究しています。</p><a class="more" href={`${base}research/`}>研究紹介 →</a></div><img src={flower} alt="斜面に咲く花"/></section>}
{d.kind==='archive'&&<><section class="archive-title"><p>SAITAMA UNIVERSITY / BIOLOGY</p><h1>生命適応科学研究室</h1><p>植物の低温・凍結・乾燥への適応機構を研究しています。</p></section><section class="archive-grid"><a class="tile large" href={`${base}research/`}><img src={flower} alt="斜面に咲く花"/><div><span>01 / RESEARCH</span><h2>植物の凍結適応と脱馴化 ↗</h2></div></a><a class="tile" href={`${base}research/`}><img src={plants} alt="群生する植物"/><div><span>02 / RESEARCH</span><h2>細胞壁・多糖と凍結耐性 ↗</h2></div></a><a class="tile text-tile" href={`${base}publications/`}><span>03 / PUBLICATIONS</span><h2>研究業績</h2><p>主要論文と研究成果</p><span class="arrow">↗</span></a></section></>}
{d.kind==='compact'&&<><section class="compact-title"><span>SAITAMA UNIVERSITY</span><h1>生命適応科学研究室</h1><p>Laboratory of Stress and Adaptation Biology</p></section><div class="compact-grid"><figure><img src={flower} alt="斜面に咲く花"/><figcaption>植物の環境ストレス応答</figcaption></figure><section class="compact-info"><span class="micro">RESEARCH</span><h2>研究概要</h2><p>植物の低温・凍結・乾燥への適応機構を、細胞壁と多糖に着目して研究しています。</p><ul><li>植物の凍結適応と脱馴化</li><li>細胞壁・多糖と凍結耐性</li><li>復活植物の乾燥耐性</li></ul><a href={`${base}research/`}>研究紹介 →</a></section></div></>}
<section class="news"><div class="news-heading"><h2>お知らせ</h2><small>NEWS</small></div><div class="news-list">{news.slice(0,d.kind==='compact'?4:3).map(n=><article><time>{n.date}</time><p>{n.text}</p></article>)}</div></section>
<footer><span>埼玉大学大学院理工学研究科</span><a href={`${base}contact/`}>お問い合わせ ↗</a><small>© Laboratory of Stress and Adaptation Biology</small></footer>
</div>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-tone]');
function update(){const chosen=document.documentElement.dataset.tone||document.body.className.match(/default-(\w+)/)?.[1];buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.tone===chosen)));}
buttons.forEach(b=>b.addEventListener('click',()=>{const tone=b.dataset.tone!;document.documentElement.dataset.tone=tone;const u=new URL(location.href);u.searchParams.set('tone',tone);history.replaceState(null,'',u);update();}));update();
</script>
</body></html>
<style is:global>
*{box-sizing:border-box}body{--bg:#fafaf8;--fg:#171717;--muted:#62625e;--line:#cececa;--soft:#ecece7;margin:0;background:var(--bg);color:var(--fg);font-family:Arial,'Hiragino Kaku Gothic ProN','Yu Gothic',sans-serif}.default-dark{--bg:#0c0c0c;--fg:#eee;--muted:#aaa;--line:#383838;--soft:#1a1a1a;color-scheme:dark}.default-paper{--bg:#ede9df;--fg:#252723;--muted:#68665e;--line:#c4c0b5;--soft:#dfdbd1}html[data-tone=dark] body{--bg:#0c0c0c;--fg:#eee;--muted:#aaa;--line:#383838;--soft:#1a1a1a;color-scheme:dark}html[data-tone=light] body{--bg:#fafaf8;--fg:#171717;--muted:#62625e;--line:#cececa;--soft:#ecece7;color-scheme:light}html[data-tone=paper] body{--bg:#ede9df;--fg:#252723;--muted:#68665e;--line:#c4c0b5;--soft:#dfdbd1;color-scheme:light}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:5px}img{display:block;width:100%;height:100%;object-fit:cover}h1,h2,p,figure{margin:0}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible{outline:2px solid currentColor;outline-offset:5px}.compare{height:48px;display:flex;align-items:center;gap:22px;padding:0 28px;background:var(--soft);border-bottom:1px solid var(--line);font-size:11px}.compare>span{color:var(--muted)}.tone-buttons{margin-left:auto;display:flex;gap:6px}.tone-buttons button{color:var(--fg);background:none;border:1px solid var(--line);padding:6px 12px;font-size:10px}.tone-buttons button[aria-pressed=true]{border-color:var(--fg);font-weight:700}.site{max-width:1800px;margin:auto}.site-header{padding:30px 5%;display:flex;justify-content:space-between;align-items:center;gap:25px}.identity{font-size:19px;letter-spacing:.05em;font-weight:600}.identity small{font-family:Arial,sans-serif;display:block;font-size:9px;margin-top:9px;font-weight:400;letter-spacing:.025em}nav{display:flex;gap:28px;font-size:11px;white-space:nowrap}.micro{font-size:10px;letter-spacing:.13em}.english{font-family:Arial,sans-serif}.news{margin:60px 7%;display:grid;grid-template-columns:1fr 3fr;gap:40px;border-top:1px solid var(--line);padding-top:25px}.news h2{font-size:18px;font-weight:500}.news-heading small{display:block;font-size:9px;color:var(--muted);margin-top:10px}.news-list article{display:grid;grid-template-columns:100px 1fr;gap:25px;padding:14px 0;border-bottom:1px solid var(--line);font-size:11px;line-height:1.8}.news-list time{color:var(--muted)}footer{border-top:1px solid var(--line);padding:30px 5%;display:flex;flex-wrap:wrap;gap:25px;font-size:10px;color:var(--muted)}footer small{margin-left:auto;font-size:8px}
/* 01: photograph-led */
.gallery .site-header{padding:25px 4%}.gallery .identity{font-size:14px}.gallery .identity small{font-size:8px}.gallery-hero{height:620px;max-height:78svh;min-height:440px;position:relative;margin:0 18px}.gallery-hero:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#0009,transparent 55%);pointer-events:none}.gallery-hero img{object-position:center 60%}.gallery-title{position:absolute;z-index:1;bottom:55px;left:4%;color:#fff}.gallery-title h1{font-size:clamp(25px,3vw,42px);font-weight:400;letter-spacing:.1em;margin:16px 0}.gallery-title p{font-size:10px;letter-spacing:.08em}.gallery-link{position:absolute;z-index:1;bottom:58px;right:4%;color:#fff;font-size:11px}
/* 02: institutional */
.standard .site{max-width:1200px}.standard .site-header{padding:36px 5%}.standard-banner{height:330px;margin:0 5%;position:relative}.standard-banner img{object-position:center 62%}.standard-banner span{position:absolute;top:22px;right:25px;color:white;font-size:9px;letter-spacing:.12em;text-shadow:0 1px 4px #000}.standard-intro{padding:35px 5% 0;display:grid;grid-template-columns:1fr 1fr;gap:15px 45px}.standard-intro h1{font-size:23px;font-weight:500;line-height:1.7}.standard-intro p{font-size:12px;line-height:2;color:var(--muted)}.standard-intro>a{grid-column:2;font-size:11px}.standard .news{margin:45px 5%}
/* 03: editorial */
.editorial .site-header{margin:0 5%;padding:25px 0;border-bottom:1px solid var(--line)}.editorial .identity{font-size:13px;font-weight:400}.editorial .identity small{display:none}.editorial-hero{display:grid;grid-template-columns:.85fr 1.3fr;gap:5%;margin:65px 7% 0;align-items:center}.editorial-title>p:first-child{font-size:11px;letter-spacing:.1em}.editorial-title h1{font-family:'Hiragino Mincho ProN','Yu Mincho',Georgia,serif;font-size:clamp(36px,4.6vw,70px);font-weight:400;line-height:1.55;letter-spacing:.1em;margin:25px 0}.editorial-title .english{font-family:Georgia,serif;font-size:15px;line-height:1.6;color:var(--muted)}.editorial-hero figure{height:440px}.editorial-hero img{height:calc(100% - 30px)}figcaption{font-size:9px;color:var(--muted);padding-top:12px}.editorial .news h2{font-family:'Hiragino Mincho ProN','Yu Mincho',serif}
/* 04: split */
.split .site-header{border-bottom:1px solid var(--line)}.split .identity{font-size:13px}.split .identity small{display:none}.split-hero{display:grid;grid-template-columns:1fr 1fr;min-height:570px}.split-hero>div{padding:65px 12% 50px}.split-hero h1{font-size:clamp(32px,4vw,65px);font-weight:500;line-height:1.65;letter-spacing:.08em;margin:30px 0}.split-hero .english{font-size:12px;line-height:1.7;color:var(--muted)}.description{font-size:12px;line-height:2.1;margin-top:35px;max-width:340px}.more{display:inline-block;font-size:11px;margin-top:30px;border-bottom:1px solid var(--line);padding-bottom:9px}.split-hero>img{min-height:570px;object-position:28% center}.split .news{margin-top:40px}
/* 05: archive */
.archive .site-header{padding:24px 5%;border-bottom:1px solid var(--line)}.archive .identity{font-size:13px}.archive .identity small{display:none}.archive-title{padding:48px 5% 35px}.archive-title>p:first-child{font-size:9px;letter-spacing:.1em}.archive-title h1{font-size:clamp(28px,4.5vw,65px);font-weight:600;letter-spacing:.06em;margin:20px 0}.archive-title>p:last-child{font-size:12px;color:var(--muted)}.archive-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin:0 5%}.tile{display:block;border-top:1px solid var(--line)}.tile img{height:180px;margin-top:15px}.tile>div{padding:18px 0}.tile span{font-size:9px;letter-spacing:.08em;color:var(--muted)}.tile h2{font-size:15px;font-weight:500;margin-top:12px;line-height:1.7}.tile.large{grid-row:span 2}.tile.large img{height:350px}.text-tile{background:var(--soft);padding:20px;position:relative;min-height:130px}.text-tile h2{font-size:22px}.text-tile p{font-size:10px;color:var(--muted);margin-top:10px}.text-tile .arrow{position:absolute;right:20px;bottom:18px;font-size:24px;color:var(--fg)}.archive .news{margin:45px 5%}
/* 06: dense */
.compact .site{max-width:1150px;padding:0 35px}.compact .site-header{padding:22px 0;border-bottom:1px solid var(--line)}.compact .identity{font-size:12px}.compact .identity small{display:none}.compact nav{font-size:10px;gap:25px}.compact-title{padding:30px 0;border-bottom:1px solid var(--line)}.compact-title>span{font-size:9px;color:var(--muted);letter-spacing:.12em}.compact-title h1{font-size:34px;font-weight:500;letter-spacing:.06em;margin:15px 0 10px}.compact-title p{font-size:10px;color:var(--muted)}.compact-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:35px;padding:25px 0}.compact-grid figure img{height:300px}.compact-info{padding:15px 0}.compact-info h2{font-size:18px;font-weight:400;margin:16px 0}.compact-info p,.compact-info li{font-size:11px;line-height:2;color:var(--muted)}.compact-info ul{padding-left:16px;margin:16px 0}.compact-info>a{font-size:10px}.compact .news{margin:0 0 35px;grid-template-columns:1fr 3fr;padding-top:20px;gap:20px}.compact .news-list article{padding:10px 0;font-size:10px}.compact .news h2{font-size:14px}.compact footer{padding:25px 0}
html[data-preview=true] .compare{display:none}
@media(max-width:750px){.compare{padding:0 14px;gap:12px;font-size:10px}.compare>span{max-width:90px;overflow:hidden;white-space:nowrap}.tone-buttons button{padding:6px 9px;font-size:9px}.site-header{padding:25px 6%;display:block}.identity{font-size:16px}nav{margin-top:24px;gap:0;justify-content:space-between;font-size:10px}.news{grid-template-columns:1fr;gap:20px;margin:40px 6%}.news-heading{display:flex;align-items:center;gap:15px}.news-heading small{margin:0}.news-list article{grid-template-columns:80px 1fr;gap:12px}.gallery-hero{margin:0 10px;height:68svh;min-height:420px}.gallery-hero img{object-position:32% center}.gallery-title{bottom:55px;left:6%}.gallery-title h1{font-size:25px}.gallery-title p{font-size:8px}.gallery-link{bottom:22px;right:6%;font-size:10px}.standard-banner{height:260px}.standard-intro{grid-template-columns:1fr;gap:18px}.standard-intro>a{grid-column:auto}.editorial-hero{margin:35px 6% 0;grid-template-columns:1fr;gap:30px}.editorial-title h1{font-size:39px;margin:20px 0}.editorial-title .english{font-size:12px}.editorial-hero figure{height:300px}.split-hero{grid-template-columns:1fr}.split-hero>div{padding:40px 7%}.split-hero h1{font-size:38px;margin:20px 0}.description{margin-top:20px}.split-hero>img{height:390px;min-height:0;object-position:32% center}.archive-title{padding-top:35px}.archive-title h1{font-size:29px;line-height:1.7}.archive-title>p:last-child{line-height:2}.archive-grid{grid-template-columns:1fr}.tile.large{grid-row:auto}.tile.large img{height:300px}.tile img{height:240px}.compact .site{padding:0 20px}.compact-title h1{font-size:28px}.compact-grid{grid-template-columns:1fr;gap:15px}.compact-grid figure img{height:260px}.compact-info{padding:10px 0}.compact .news{grid-template-columns:1fr;gap:15px}footer{gap:18px}footer small{margin-left:0;width:100%}}
</style>
